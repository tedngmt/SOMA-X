#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
updates=$(mktemp) || exit 1
trap 'rm -f "$updates"' EXIT HUP INT TERM
cat > "$updates" || exit 1
if command -v python3 >/dev/null 2>&1; then
    python3 tools/ci/check_public_release.py --pre-push < "$updates" || exit 1
elif command -v python >/dev/null 2>&1; then
    python tools/ci/check_public_release.py --pre-push < "$updates" || exit 1
else
    echo "Push blocked: Python is required for the local data guard." >&2
    exit 1
fi
# Run the guard before Git LFS can upload any objects.
command -v git-lfs >/dev/null 2>&1 || { echo "Git LFS is required." >&2; exit 1; }
git lfs pre-push "$@" < "$updates"
